<Project>
  <PropertyGroup>
    <!-- Numéro de version unique de Stokbox : assemblies, écran « À propos » et nom de l'installateur. -->
    <Version>1.0.0</Version>
    <Product>Stokbox</Product>
    <!-- La version affichée est exactement celle ci-dessus, sans identifiant de commit ajouté par le SDK. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <!-- Allows building the net48/WPF projects with the .NET SDK on a non-Windows machine (CI, dev). No effect on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
