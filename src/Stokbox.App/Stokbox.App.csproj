<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Stokbox</AssemblyName>
    <RootNamespace>Stokbox.App</RootNamespace>
  </PropertyGroup>

  <!-- Identité visuelle (dossier assets à la racine). L'icône de l'exécutable est aussi celle de toutes les fenêtres :
       une fenêtre WPF sans icône propre reprend celle de l'exécutable. Générée par tools\make-icon.ps1. -->
  <PropertyGroup Condition="Exists('..\..\assets\stokbox.ico')">
    <ApplicationIcon>..\..\assets\stokbox.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Condition="Exists('..\..\assets\logo.png')">
    <Resource Include="..\..\assets\logo.png" Link="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stokbox.Core\Stokbox.Core.csproj" />
    <ProjectReference Include="..\Stokbox.Data\Stokbox.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Impression WPF : files d'impression Windows et écriture du document vers le pilote. -->
    <Reference Include="ReachFramework" />
    <Reference Include="System.Printing" />
    <!-- Sélecteur de dossier Windows (sauvegarde manuelle) : WPF ne le fournit pas sur .NET Framework. -->
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
