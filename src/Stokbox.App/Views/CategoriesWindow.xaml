<Window x:Class="Stokbox.App.Views.CategoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catégories"
        Width="440" Height="460"
        MinWidth="380" MinHeight="340"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox Grid.Row="0"
                 ItemsSource="{Binding Categories}"
                 SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                 DisplayMemberPath="Name" />

        <TextBlock Grid.Row="1" Text="Nom de la catégorie" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Grid.Row="2" x:Name="NameBox"
                 Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="60" Padding="4,3" />
        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Style="{StaticResource FieldErrorStyle}" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="Ajouter" Command="{Binding AddCommand}"
                    Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
            <Button Content="Renommer" Command="{Binding RenameCommand}"
                    Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
            <Button Content="Supprimer" Command="{Binding DeleteCommand}"
                    Style="{StaticResource ActionButtonStyle}" />
        </StackPanel>

        <Button Grid.Row="5" Content="Fermer" IsCancel="True"
                Style="{StaticResource ActionButtonStyle}"
                HorizontalAlignment="Right" Margin="0,18,0,0" />
    </Grid>
</Window>
