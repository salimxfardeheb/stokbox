<UserControl x:Class="Stokbox.App.Views.LabelSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Stokbox.App.Controls"
             Focusable="False">
    <UserControl.Resources>
        <!-- Un champ du formulaire : libellé, saisie, message d'erreur dessous. -->
        <DataTemplate x:Key="FormFieldTemplate">
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" Padding="4,3" />
                <TextBlock Text="{Binding Error}" Style="{StaticResource FieldErrorStyle}" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="FieldHostStyle" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource FormFieldTemplate}" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" MinWidth="220" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <TextBlock Text="Étiquettes" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Foreground="#52606D" TextWrapping="Wrap" Margin="0,4,16,0"
                           Text="Imprimante thermique en rouleau : 1 colonne × 1 ligne, marges à 0. Planche A4 : indiquez les colonnes, les lignes, les marges et les espacements de la planche." />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ContentControl Grid.Row="0" Grid.Column="0" Content="{Binding Width}" Style="{StaticResource FieldHostStyle}" />
                    <ContentControl Grid.Row="0" Grid.Column="1" Content="{Binding Height}" Style="{StaticResource FieldHostStyle}" />
                    <ContentControl Grid.Row="1" Grid.Column="0" Content="{Binding Columns}" Style="{StaticResource FieldHostStyle}" />
                    <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding Rows}" Style="{StaticResource FieldHostStyle}" />
                    <ContentControl Grid.Row="2" Grid.Column="0" Content="{Binding MarginLeft}" Style="{StaticResource FieldHostStyle}" />
                    <ContentControl Grid.Row="2" Grid.Column="1" Content="{Binding MarginTop}" Style="{StaticResource FieldHostStyle}" />
                    <ContentControl Grid.Row="3" Grid.Column="0" Content="{Binding HorizontalGap}" Style="{StaticResource FieldHostStyle}" />
                    <ContentControl Grid.Row="3" Grid.Column="1" Content="{Binding VerticalGap}" Style="{StaticResource FieldHostStyle}" />
                </Grid>

                <TextBlock Text="Imprimante" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding PrinterOptions}"
                          SelectedItem="{Binding SelectedPrinter, Mode=TwoWay}"
                          DisplayMemberPath="Display"
                          Margin="0,0,16,0" />
                <TextBlock Foreground="#7B8794" FontSize="12" TextWrapping="Wrap" Margin="0,4,16,0"
                           Text="Avec une imprimante enregistrée, l'impression part directement, sans boîte de dialogue. Le format du papier se règle dans les préférences de l'imprimante sous Windows." />

                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Button Content="Enregistrer" Command="{Binding SaveCommand}"
                            Style="{StaticResource ActionButtonStyle}" FontWeight="SemiBold" Margin="0,0,8,0" />
                    <Button Content="Imprimer une étiquette de test" Command="{Binding PrintTestCommand}"
                            Style="{StaticResource ActionButtonStyle}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#1E6B34" TextWrapping="Wrap" Margin="0,10,16,0" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Aperçu d'une page" Foreground="#52606D" Margin="0,0,0,8" />
            <Border Background="#DDE2E8" Padding="16">
                <controls:LabelPagePreview Settings="{Binding PreviewSettings}" Labels="{Binding PreviewLabels}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
