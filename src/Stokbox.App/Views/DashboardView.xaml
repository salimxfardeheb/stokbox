<!-- Language : les sélecteurs de date affichent jj/mm/aaaa et un calendrier en français. -->
<UserControl x:Class="Stokbox.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Language="fr-FR"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TileStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD2D9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="14,10,14,12" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
        <Style x:Key="TileLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#52606D" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="TileValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Tuile cliquable : même aspect qu'une tuile, avec un contour marqué au survol et au clavier. -->
        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="White"
                                BorderBrush="#CBD2D9"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="14,10,14,12"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource NavyBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource NavyBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RightAlignedCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style x:Key="RightAlignedHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>

        <Style x:Key="ReadOnlyGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E4E7EB" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD2D9" />
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style x:Key="EmptyTableTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7B8794" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <!-- Texte d'un axe du graphique : absent tant qu'il est vide. -->
        <Style x:Key="AxisTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#52606D" />
            <Setter Property="FontSize" Value="12" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel Margin="0,0,6,0">

            <!-- Actualisation et état du calcul -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button Content="Actualiser" Command="{Binding RefreshCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="6" VerticalAlignment="Center"
                                 Foreground="{StaticResource NavyBrush}" />
                    <TextBlock Text="Calcul en cours…" Foreground="#52606D" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FieldErrorStyle}" FontSize="14" Margin="0,0,0,12" />

            <!-- Stock -->
            <TextBlock Text="Stock" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />
            <UniformGrid Columns="3" Margin="0,0,-12,8">
                <Border Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock Text="Valeur au prix d'achat" Style="{StaticResource TileLabelStyle}" />
                        <TextBlock Text="{Binding StockPurchaseValueText}" Style="{StaticResource TileValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock Text="Valeur au prix de vente" Style="{StaticResource TileLabelStyle}" />
                        <TextBlock Text="{Binding StockSaleValueText}" Style="{StaticResource TileValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock Text="Marge potentielle" Style="{StaticResource TileLabelStyle}" />
                        <TextBlock Text="{Binding StockMarginText}" Style="{StaticResource TileValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock Text="Références en stock" Style="{StaticResource TileLabelStyle}" />
                        <TextBlock Text="{Binding StockReferenceCountText}" Style="{StaticResource TileValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock Text="Unités en stock" Style="{StaticResource TileLabelStyle}" />
                        <TextBlock Text="{Binding StockUnitCountText}" Style="{StaticResource TileValueStyle}" />
                    </StackPanel>
                </Border>
                <Button x:Name="OutOfStockTile" Style="{StaticResource TileButtonStyle}"
                        Command="{Binding ShowOutOfStockCommand}"
                        ToolTip="Ouvrir l'écran Produits filtré sur les produits en rupture">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="Voir ›" Foreground="{StaticResource PrimaryBrush}"
                                       FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" />
                            <TextBlock Text="Produits en rupture" Style="{StaticResource TileLabelStyle}" />
                        </DockPanel>
                        <TextBlock Text="{Binding OutOfStockCountText}" Style="{StaticResource TileValueStyle}" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Ventes : période -->
            <WrapPanel Margin="0,6,0,10">
                <TextBlock Text="Ventes" Style="{StaticResource SectionTitleStyle}" Margin="0,0,20,6" />
                <ComboBox x:Name="PeriodBox"
                          ItemsSource="{Binding Periods}"
                          SelectedItem="{Binding SelectedPeriod, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          Width="200" Margin="0,0,16,6" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsCustomPeriod, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Du" VerticalAlignment="Center" Margin="0,0,8,6" />
                    <DatePicker SelectedDate="{Binding CustomFrom, Mode=TwoWay}" Width="130" Margin="0,0,12,6" />
                    <TextBlock Text="au" VerticalAlignment="Center" Margin="0,0,8,6" />
                    <DatePicker SelectedDate="{Binding CustomTo, Mode=TwoWay}" Width="130" Margin="0,0,16,6" />
                </StackPanel>
                <TextBlock Text="{Binding PeriodText}" Foreground="#52606D" VerticalAlignment="Center" Margin="0,0,0,6" />
            </WrapPanel>

            <UniformGrid Columns="3" Margin="0,0,-12,8">
                <Border Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock Text="CA net" Style="{StaticResource TileLabelStyle}"
                                   ToolTip="Chiffre d'affaires des ventes validées, retours déduits" />
                        <TextBlock Text="{Binding NetRevenueText}" Style="{StaticResource TileValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock Text="Bénéfice brut" Style="{StaticResource TileLabelStyle}"
                                   ToolTip="CA net moins le coût d'achat des articles vendus" />
                        <TextBlock Text="{Binding GrossProfitText}" Style="{StaticResource TileValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock Text="Taux de marge" Style="{StaticResource TileLabelStyle}"
                                   ToolTip="Bénéfice brut rapporté au CA net" />
                        <TextBlock Text="{Binding MarginRateText}" Style="{StaticResource TileValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock Text="Nombre de ventes" Style="{StaticResource TileLabelStyle}" />
                        <TextBlock Text="{Binding SaleCountText}" Style="{StaticResource TileValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock Text="Panier moyen" Style="{StaticResource TileLabelStyle}"
                                   ToolTip="Total des ventes divisé par leur nombre, avant retours" />
                        <TextBlock Text="{Binding AverageBasketText}" Style="{StaticResource TileValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock Text="Articles vendus nets" Style="{StaticResource TileLabelStyle}"
                                   ToolTip="Quantités vendues moins quantités retournées" />
                        <TextBlock Text="{Binding NetItemCountText}" Style="{StaticResource TileValueStyle}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Graphique : une colonne par jour, la barre part de la ligne du zéro. -->
            <Border Background="White" BorderBrush="#CBD2D9" BorderThickness="1" CornerRadius="2"
                    Padding="14,10,14,10" Margin="0,0,0,20">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CA net par jour" FontWeight="SemiBold"
                               Foreground="{StaticResource NavyBrush}" Margin="0,0,0,6" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ChartMaxText}" Style="{StaticResource AxisTextStyle}" />
                    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding ChartFirstDayText}" Style="{StaticResource AxisTextStyle}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ChartLastDayText}" Style="{StaticResource AxisTextStyle}" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ChartMinText}" Style="{StaticResource AxisTextStyle}" />
                    <ItemsControl x:Name="DailyChart" ItemsSource="{Binding DailyBars}" Height="190" Focusable="False"
                                  Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Fond transparent : toute la colonne du jour répond au survol, même sans barre. -->
                                <Grid x:Name="DayColumn" Background="Transparent"
                                      ToolTip="{Binding ToolTipText}"
                                      ToolTipService.InitialShowDelay="0"
                                      ToolTipService.ShowDuration="60000">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="{Binding TopGap}" />
                                        <RowDefinition Height="{Binding Positive}" />
                                        <RowDefinition Height="{Binding Negative}" />
                                        <RowDefinition Height="{Binding BottomGap}" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Rectangle x:Name="PositiveBar" Grid.Row="1" Fill="{StaticResource NavyBrush}"
                                               MaxWidth="36" Margin="1,0" />
                                    <Rectangle x:Name="NegativeBar" Grid.Row="2" Fill="#C0392B"
                                               MaxWidth="36" Margin="1,0" />
                                    <!-- Ligne du zéro, continue d'une colonne à l'autre. -->
                                    <Border Grid.Row="0" Grid.RowSpan="2" BorderBrush="#9AA5B1" BorderThickness="0,0,0,1"
                                            IsHitTestVisible="False" />
                                    <TextBlock Grid.Row="4" Text="{Binding Label}" FontSize="11" Foreground="#52606D"
                                               HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="DayColumn" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="DayColumn" Property="Background" Value="#F7F5F0" />
                                        <Setter TargetName="PositiveBar" Property="Fill" Value="#2E4380" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- Tableaux -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="5*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Top 10 produits" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"
                               Margin="0,0,0,6" />
                    <DataGrid x:Name="TopProductsGrid" Style="{StaticResource ReadOnlyGridStyle}"
                              ItemsSource="{Binding TopProducts}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Désignation" Binding="{Binding Name}" Width="*" MinWidth="120" />
                            <DataGridTextColumn Header="Quantité nette" Binding="{Binding QuantityText}"
                                                ElementStyle="{StaticResource RightAlignedCellStyle}"
                                                HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                Width="110" />
                            <DataGridTextColumn Header="CA net" Binding="{Binding RevenueText}"
                                                ElementStyle="{StaticResource RightAlignedCellStyle}"
                                                HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Aucun produit vendu sur la période." Style="{StaticResource EmptyTableTextStyle}"
                               Visibility="{Binding HasNoTopProducts, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="CA par catégorie" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"
                               Margin="0,0,0,6" />
                    <DataGrid x:Name="CategoriesGrid" Style="{StaticResource ReadOnlyGridStyle}"
                              ItemsSource="{Binding Categories}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Catégorie" Binding="{Binding Name}" Width="*" MinWidth="110" />
                            <DataGridTextColumn Header="CA net" Binding="{Binding RevenueText}"
                                                ElementStyle="{StaticResource RightAlignedCellStyle}"
                                                HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                Width="130" />
                            <DataGridTextColumn Header="% du total" Binding="{Binding ShareText}"
                                                ElementStyle="{StaticResource RightAlignedCellStyle}"
                                                HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                                Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Aucune vente sur la période." Style="{StaticResource EmptyTableTextStyle}"
                               Visibility="{Binding HasNoCategories, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
