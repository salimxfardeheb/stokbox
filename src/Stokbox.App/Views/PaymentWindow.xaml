<Window x:Class="Stokbox.App.Views.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Encaissement"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True">
    <StackPanel Margin="24,18,24,22">
        <TextBlock Text="Total à payer" Foreground="#52606D" />
        <TextBlock Text="{Binding TotalText}" FontSize="34" FontWeight="Bold" />

        <TextBlock Text="Montant reçu en espèces (DA)" Style="{StaticResource FieldLabelStyle}" />
        <TextBox x:Name="ReceivedBox"
                 Text="{Binding ReceivedText, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="26" Padding="6,4" MaxLength="16" TextAlignment="Right" />
        <TextBlock Text="{Binding Error}" Style="{StaticResource FieldErrorStyle}" FontSize="13" />

        <TextBlock Text="{Binding ChangeCaption}" Foreground="#52606D" Margin="0,16,0,0" />
        <TextBlock Text="{Binding ChangeText}" FontSize="30" FontWeight="Bold">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#1E6B34" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsShort}" Value="True">
                            <Setter Property="Foreground" Value="#C0392B" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Valider (Entrée)" Command="{Binding ConfirmCommand}" IsDefault="True"
                    Style="{StaticResource ActionButtonStyle}" FontWeight="SemiBold" Margin="0,0,8,0" />
            <Button Content="Annuler (Échap)" IsCancel="True" Style="{StaticResource ActionButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
