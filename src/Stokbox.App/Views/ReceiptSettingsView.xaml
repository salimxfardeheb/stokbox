<UserControl x:Class="Stokbox.App.Views.ReceiptSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <StackPanel Width="460" HorizontalAlignment="Left">
        <TextBlock Text="Boutique et ticket" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Foreground="#52606D" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="Ces informations sont imprimées en tête du ticket de caisse (imprimante ticket 80 mm)." />

        <TextBlock Text="Nom de la boutique" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Text="{Binding ShopName, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" Padding="4,3" />

        <TextBlock Text="Adresse" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Text="{Binding ShopAddress, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" Padding="4,3" />

        <TextBlock Text="Téléphone" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Text="{Binding ShopPhone, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Padding="4,3" />

        <TextBlock Text="Imprimante ticket" Style="{StaticResource FieldLabelStyle}" />
        <ComboBox ItemsSource="{Binding PrinterOptions}"
                  SelectedItem="{Binding SelectedPrinter, Mode=TwoWay}"
                  DisplayMemberPath="Display" />
        <TextBlock Foreground="#7B8794" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="Sans imprimante ticket, le ticket n'est jamais proposé après une vente." />

        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
            <Button Content="Enregistrer" Command="{Binding SaveCommand}"
                    Style="{StaticResource ActionButtonStyle}" FontWeight="SemiBold" Margin="0,0,8,0" />
            <Button Content="Imprimer un ticket de test" Command="{Binding PrintTestCommand}"
                    Style="{StaticResource ActionButtonStyle}" />
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}" Foreground="#1E6B34" TextWrapping="Wrap" Margin="0,10,0,0" />
    </StackPanel>
</UserControl>
