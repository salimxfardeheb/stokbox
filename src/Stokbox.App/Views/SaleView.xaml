<UserControl x:Class="Stokbox.App.Views.SaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Stokbox.App.Controls"
             xmlns:converters="clr-namespace:Stokbox.App.Converters"
             Focusable="False"
             PreviewKeyDown="OnPreviewKeyDown"
             PreviewTextInput="OnPreviewTextInput">
    <UserControl.Resources>
        <converters:MoneyConverter x:Key="MoneyConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="RightAlignedCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style x:Key="LeftCellStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style x:Key="RightAlignedHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>

        <!-- Le focus clavier reste dans le champ de recherche : ces boutons se cliquent sans le prendre. -->
        <Style x:Key="SideButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Recherche produit : le scanner et le clavier arrivent toujours ici. -->
        <controls:ProductSearchBox x:Name="SearchBox" Grid.Row="0" Grid.Column="0" DataContext="{Binding Search}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Message}"
                   Style="{StaticResource FieldErrorStyle}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" />

        <!-- Panier -->
        <DataGrid x:Name="CartGrid" Grid.Row="2" Grid.Column="0" Margin="0,10,0,0"
                  ItemsSource="{Binding Lines}"
                  SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  IsTabStop="False"
                  KeyboardNavigation.TabNavigation="None"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E4E7EB"
                  Background="White"
                  BorderBrush="#CBD2D9"
                  FontSize="16"
                  RowHeight="40"
                  GotKeyboardFocus="OnCartGridGotKeyboardFocus"
                  SelectionChanged="OnCartSelectionChanged">
            <DataGrid.Resources>
                <!-- La ligne sélectionnée reste bien visible alors que le focus est dans la recherche. -->
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CFE5F7" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1F2933" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#CFE5F7" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1F2933" />
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Désignation" Binding="{Binding Name}" Width="*" MinWidth="160"
                                    ElementStyle="{StaticResource LeftCellStyle}" />
                <DataGridTextColumn Header="Prix unitaire"
                                    Binding="{Binding UnitPriceCents, Converter={StaticResource MoneyConverter}}"
                                    ElementStyle="{StaticResource RightAlignedCellStyle}"
                                    HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                    Width="140" />
                <DataGridTemplateColumn Header="Quantité" Width="100" HeaderStyle="{StaticResource RightAlignedHeaderStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=LostFocus}"
                                     TextAlignment="Right" VerticalContentAlignment="Center"
                                     Margin="6,4" Padding="2,0" MaxLength="6" IsTabStop="False"
                                     GotKeyboardFocus="OnQuantityBoxGotKeyboardFocus"
                                     ToolTip="Tapez la quantité puis Entrée (ou utilisez + et − depuis la recherche)" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Total"
                                    Binding="{Binding LineTotalCents, Converter={StaticResource MoneyConverter}}"
                                    ElementStyle="{StaticResource RightAlignedCellStyle}"
                                    HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                    FontWeight="SemiBold"
                                    Width="150" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,0,0" Foreground="#7B8794" TextWrapping="Wrap"
                   Text="F2 : encaisser   ·   + / − : quantité   ·   ↑ ↓ : changer de ligne   ·   Suppr : retirer la ligne   ·   Échap : vider le panier" />

        <!-- Total et encaissement -->
        <DockPanel Grid.Row="0" Grid.RowSpan="4" Grid.Column="2">
            <Border DockPanel.Dock="Top" Background="#1F2933" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="TOTAL" Foreground="#9AA5B1" FontSize="14" />
                    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Right" Height="64">
                        <TextBlock Text="{Binding TotalText}" Foreground="White" FontSize="46" FontWeight="Bold" />
                    </Viewbox>
                    <TextBlock Text="{Binding ArticleCountText}" Foreground="#9AA5B1" HorizontalAlignment="Right" />
                </StackPanel>
            </Border>

            <Button DockPanel.Dock="Top" Content="Encaisser (F2)" Command="{Binding CheckoutCommand}"
                    Style="{StaticResource SideButtonStyle}" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,0" />
            <Button DockPanel.Dock="Top" Content="Vider le panier (Échap)" Command="{Binding ClearCartCommand}"
                    Style="{StaticResource SideButtonStyle}" Margin="0,8,0,0" />

            <Border DockPanel.Dock="Top" Margin="0,18,0,0" Padding="14,10"
                    Background="#E6F4EA" BorderBrush="#A8D5B5" BorderThickness="1"
                    Visibility="{Binding HasLastSale, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding LastSaleText}" Foreground="#1E6B34" TextWrapping="Wrap" />
            </Border>

            <Grid />
        </DockPanel>
    </Grid>
</UserControl>
