<UserControl x:Class="Stokbox.App.Views.StockEntriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Stokbox.App.Controls"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="RightAlignedCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style x:Key="RightAlignedHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <!-- F6 fonctionne depuis n'importe quel champ de l'écran. -->
    <UserControl.InputBindings>
        <KeyBinding Key="F6" Command="{Binding PrintLabelsCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Produit -->
        <StackPanel Grid.Row="0" MaxWidth="760" HorizontalAlignment="Left" Width="760">
            <TextBlock Text="Produit : scannez le code-barres, ou tapez un code-barres ou une désignation puis Entrée"
                       Foreground="#52606D" Margin="0,0,0,4" TextWrapping="Wrap" />
            <controls:ProductSearchBox x:Name="SearchBox" DataContext="{Binding Search}" />
        </StackPanel>

        <!-- 2. Quantité -->
        <Border Grid.Row="1" Margin="0,14,0,0" Padding="16,12" MaxWidth="760" HorizontalAlignment="Left" Width="760"
                Background="White" BorderBrush="#CBD2D9" BorderThickness="1"
                Visibility="{Binding HasSelectedProduct, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding SelectedProduct.Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                    <TextBlock Text="{Binding SelectedProduct.Barcode}" FontFamily="Consolas" Foreground="#52606D" />
                    <TextBlock Text="{Binding SelectedProduct.StockQuantity, StringFormat='Stock actuel : {0}'}"
                               Foreground="#52606D" Margin="24,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Quantité reçue :" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox x:Name="QuantityBox"
                             Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                             Width="120" FontSize="18" Padding="6,5" MaxLength="7"
                             TextAlignment="Right">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ConfirmCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="Entrée : valider   ·   Échap : annuler"
                               Foreground="#7B8794" VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding QuantityError}" Style="{StaticResource FieldErrorStyle}" FontSize="13" />
            </StackPanel>
        </Border>

        <!-- 3. Dernière entrée et proposition d'étiquettes -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="16,10" MaxWidth="760" HorizontalAlignment="Left" Width="760"
                Background="#E6F4EA" BorderBrush="#A8D5B5" BorderThickness="1"
                Visibility="{Binding HasLastEntry, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="{Binding PrintLabelsText}"
                        Command="{Binding PrintLabelsCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="16,0,0,0" />
                <TextBlock Text="{Binding LastEntryText}" Foreground="#1E6B34"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="Entrées de la session" FontWeight="SemiBold" Margin="0,22,0,8" />

        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding Entries}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  IsTabStop="False"
                  KeyboardNavigation.TabNavigation="None"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E4E7EB"
                  Background="White"
                  BorderBrush="#CBD2D9"
                  RowHeight="30">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Heure" Binding="{Binding Time}" Width="90" />
                <DataGridTextColumn Header="Produit" Binding="{Binding ProductName}" Width="*" MinWidth="160" />
                <DataGridTextColumn Header="Code-barres" Binding="{Binding Barcode}" FontFamily="Consolas" Width="130" />
                <DataGridTextColumn Header="Quantité"
                                    Binding="{Binding Quantity, StringFormat='+{0}'}"
                                    ElementStyle="{StaticResource RightAlignedCellStyle}"
                                    HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                    Width="90" />
                <DataGridTextColumn Header="Stock après"
                                    Binding="{Binding StockQuantityAfter}"
                                    ElementStyle="{StaticResource RightAlignedCellStyle}"
                                    HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                    Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
