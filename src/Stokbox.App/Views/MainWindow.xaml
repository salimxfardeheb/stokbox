<Window x:Class="Stokbox.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:Stokbox.App.ViewModels"
        xmlns:views="clr-namespace:Stokbox.App.Views"
        Title="Stokbox"
        Width="1180" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SaleViewModel}">
            <views:SaleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ProductsViewModel}">
            <views:ProductsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:StockEntriesViewModel}">
            <views:StockEntriesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:LabelsViewModel}">
            <views:LabelsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <Style x:Key="SideMenuItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#D5DCE4" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Container"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="4,0,0,0"
                                Padding="20,14">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Container" Property="Background" Value="#26386B" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Container" Property="Background" Value="#2E4380" />
                                <Setter TargetName="Container" Property="BorderBrush" Value="#E3262B" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Background="#1B2A55">
            <TextBlock DockPanel.Dock="Top"
                       Text="Stokbox"
                       Foreground="White"
                       FontSize="22" FontWeight="SemiBold"
                       Margin="24,24,24,20" />
            <ListBox ItemsSource="{Binding MenuItems}"
                     SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}"
                     DisplayMemberPath="Title"
                     ItemContainerStyle="{StaticResource SideMenuItemStyle}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        </DockPanel>

        <!-- Zone de contenu : le titre, puis l'écran du menu sélectionné (vide tant que l'écran n'existe pas). -->
        <Border Grid.Column="1" Background="#F7F5F0" Padding="32,26">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding SelectedMenuItem.Title}"
                           FontSize="26" FontWeight="SemiBold"
                           Foreground="#1B2A55"
                           Margin="0,0,0,18" />
                <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
