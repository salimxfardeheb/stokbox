<!-- Language : les sélecteurs de date affichent jj/mm/aaaa et un calendrier en français. -->
<UserControl x:Class="Stokbox.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Stokbox.App.Converters"
             Language="fr-FR"
             Focusable="False">
    <UserControl.Resources>
        <converters:MoneyConverter x:Key="MoneyConverter" />
        <converters:LocalDateTimeConverter x:Key="LocalDateTimeConverter" />
        <converters:SaleStatusConverter x:Key="SaleStatusConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="RightAlignedCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style x:Key="RightAlignedHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>

        <Style x:Key="ReadOnlyGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E4E7EB" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD2D9" />
            <Setter Property="RowHeight" Value="30" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MinWidth="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="6*" MinWidth="380" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filtres -->
        <WrapPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
            <TextBlock Text="Du" VerticalAlignment="Center" Margin="0,0,8,6" />
            <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Width="130" Margin="0,0,12,6" />
            <TextBlock Text="au" VerticalAlignment="Center" Margin="0,0,8,6" />
            <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Width="130" Margin="0,0,12,6" />
            <Button Content="Aujourd'hui" Command="{Binding TodayCommand}"
                    Style="{StaticResource ActionButtonStyle}" Margin="0,0,28,6" />
            <TextBlock Text="N° de vente :" VerticalAlignment="Center" Margin="0,0,8,6" />
            <TextBox x:Name="NumberBox" Text="{Binding NumberText, UpdateSourceTrigger=PropertyChanged}"
                     Width="190" Padding="4,3" MaxLength="30" Margin="0,0,0,6"
                     ToolTip="Numéro complet ou partiel ; la recherche par numéro ignore la période" />
        </WrapPanel>

        <!-- Ventes -->
        <DataGrid Grid.Row="1" Grid.Column="0"
                  Style="{StaticResource ReadOnlyGridStyle}"
                  ItemsSource="{Binding Sales}"
                  SelectedItem="{Binding SelectedSale, Mode=TwoWay}"
                  SelectionUnit="FullRow">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="ANNULEE">
                            <Setter Property="Foreground" Value="#8A949E" />
                            <Setter Property="FontStyle" Value="Italic" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Numéro" Binding="{Binding Number}" FontFamily="Consolas" Width="150" />
                <DataGridTextColumn Header="Date et heure"
                                    Binding="{Binding CreatedAtUtc, Converter={StaticResource LocalDateTimeConverter}}"
                                    Width="140" />
                <DataGridTextColumn Header="Articles" Binding="{Binding ArticleCount}"
                                    ElementStyle="{StaticResource RightAlignedCellStyle}"
                                    HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                    Width="70" />
                <DataGridTextColumn Header="Total"
                                    Binding="{Binding TotalCents, Converter={StaticResource MoneyConverter}}"
                                    ElementStyle="{StaticResource RightAlignedCellStyle}"
                                    HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                    Width="*" MinWidth="110" />
                <DataGridTextColumn Header="Statut"
                                    Binding="{Binding Status, Converter={StaticResource SaleStatusConverter}}"
                                    Width="80" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding SummaryText}" Foreground="#52606D"
                   TextWrapping="Wrap" Margin="0,8,0,0" />

        <!-- Détail de la vente sélectionnée -->
        <TextBlock Grid.Row="1" Grid.Column="2" Text="Sélectionnez une vente pour voir son détail."
                   Foreground="#7B8794" VerticalAlignment="Top" Margin="0,6,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelection}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid Grid.Row="1" Grid.Column="2"
              Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" MinHeight="90" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding DetailTitle}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Text="{Binding PaymentText}" Foreground="#52606D" TextWrapping="Wrap" Margin="0,2,0,10" />

            <DataGrid Grid.Row="2" Style="{StaticResource ReadOnlyGridStyle}" ItemsSource="{Binding Lines}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Désignation" Binding="{Binding ProductName}" Width="*" MinWidth="120" />
                    <DataGridTextColumn Header="Prix unitaire"
                                        Binding="{Binding UnitPriceCents, Converter={StaticResource MoneyConverter}}"
                                        ElementStyle="{StaticResource RightAlignedCellStyle}"
                                        HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                        Width="110" />
                    <DataGridTextColumn Header="Qté" Binding="{Binding Quantity}"
                                        ElementStyle="{StaticResource RightAlignedCellStyle}"
                                        HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                        Width="50" />
                    <DataGridTextColumn Header="Retourné" Binding="{Binding ReturnedQuantity}"
                                        ElementStyle="{StaticResource RightAlignedCellStyle}"
                                        HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                        Width="75" />
                    <DataGridTextColumn Header="Total"
                                        Binding="{Binding LineTotalCents, Converter={StaticResource MoneyConverter}}"
                                        ElementStyle="{StaticResource RightAlignedCellStyle}"
                                        HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                        Width="110" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="3" FontWeight="SemiBold" Margin="0,14,0,6">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Aucun retour sur cette vente." />
                        <Setter Property="Foreground" Value="#7B8794" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasReturns}" Value="True">
                                <Setter Property="Text" Value="{Binding RefundedText}" />
                                <Setter Property="Foreground" Value="#1F2933" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <DataGrid Grid.Row="4" Style="{StaticResource ReadOnlyGridStyle}" ItemsSource="{Binding ReturnRows}"
                      Visibility="{Binding HasReturns, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Retour du" Binding="{Binding DateText}" Width="140" />
                    <DataGridTextColumn Header="Désignation" Binding="{Binding ProductName}" Width="*" MinWidth="120" />
                    <DataGridTextColumn Header="Qté" Binding="{Binding Quantity}"
                                        ElementStyle="{StaticResource RightAlignedCellStyle}"
                                        HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                        Width="50" />
                    <DataGridTextColumn Header="Remboursé"
                                        Binding="{Binding AmountCents, Converter={StaticResource MoneyConverter}}"
                                        ElementStyle="{StaticResource RightAlignedCellStyle}"
                                        HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                        Width="110" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#1E6B34" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Retour d'articles" Command="{Binding ReturnItemsCommand}"
                        Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                <Button Content="Annuler la vente" Command="{Binding CancelSaleCommand}"
                        Style="{StaticResource ActionButtonStyle}" Margin="0,0,24,0" />
                <Button Content="Réimprimer le ticket" Command="{Binding ReprintCommand}"
                        Style="{StaticResource ActionButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
