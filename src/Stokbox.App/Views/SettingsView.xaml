<UserControl x:Class="Stokbox.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Stokbox.App.Views"
             Focusable="False">
    <TabControl Background="Transparent" BorderThickness="0,1,0,0" BorderBrush="#CBD2D9" Padding="0,16,0,0">
        <TabItem Header="Étiquettes" Padding="14,6">
            <views:LabelSettingsView DataContext="{Binding Labels}" />
        </TabItem>
        <TabItem Header="Boutique et ticket" Padding="14,6">
            <views:ReceiptSettingsView DataContext="{Binding Receipt}" />
        </TabItem>
    </TabControl>
</UserControl>
