<!-- Recherche de produit réutilisable (scan / code-barres / désignation). DataContext attendu : ProductSearchViewModel. -->
<UserControl x:Class="Stokbox.App.Controls.ProductSearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Stokbox.App.Converters"
             Focusable="False">
    <UserControl.Resources>
        <converters:MoneyConverter x:Key="MoneyConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Le focus clavier reste dans le champ de saisie : la ligne en surbrillance est celle qu'Entrée choisira. -->
        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Container" Background="Transparent" Padding="8,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Container" Property="Background" Value="#EEF2F6" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Container" Property="Background" Value="#CFE5F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBox x:Name="SearchBox"
                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="18" Padding="6,5"
                 MaxLength="120"
                 PreviewKeyDown="OnSearchBoxPreviewKeyDown"
                 ToolTip="Scannez un code-barres, ou tapez un code-barres ou une désignation puis Entrée" />

        <TextBlock Text="{Binding Message}" Style="{StaticResource FieldErrorStyle}" FontSize="13" />

        <ListBox x:Name="ResultList"
                 ItemsSource="{Binding Results}"
                 SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                 Visibility="{Binding IsResultListOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                 ItemContainerStyle="{StaticResource ResultItemStyle}"
                 Focusable="False"
                 MaxHeight="230"
                 Margin="0,4,0,0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="OnResultSelectionChanged"
                 PreviewMouseLeftButtonUp="OnResultListMouseUp">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Barcode}" FontFamily="Consolas" Foreground="#52606D" />
                        <TextBlock Grid.Column="2" TextAlignment="Right"
                                   Text="{Binding SalePriceCents, Converter={StaticResource MoneyConverter}}" />
                        <TextBlock Grid.Column="3" TextAlignment="Right" Foreground="#52606D"
                                   Text="{Binding StockQuantity, StringFormat='Stock : {0}'}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>
